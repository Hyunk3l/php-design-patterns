{
    "name": "hyunk3l/php-design-patterns",
    "description": "Just another design patterns collection for PHP",
    "authors": [
        {
            "name": "Fabrizio Di Napoli",
            "email": "04genteel_tiff@icloud.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Hyunk3l\\PhpDesignPatterns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyunk3l\\Test\\PhpDesignPatterns\\": "test/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3"
    },
    "scripts": {
        "test": "vendor/bin/phpunit test/",
        "cs": "vendor/bin/phpcs src test",
        "ci": [
            "@test",
            "@cs"
        ]
    }
}
